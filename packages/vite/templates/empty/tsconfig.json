{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "resolveJsonModule": true, "isolatedModules": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["game", "vite.config.ts"], "exclude": ["dist", "node_modules"]
}
