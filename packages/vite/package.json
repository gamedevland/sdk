{
  "name": "@gamedevland/vite",
  "version": "0.0.1",
  "type": "module",
  "description": "Vite build tooling for Gamedev Land HTML5 games.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "pretypecheck": "npm run build -w @gamedevland/engine",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths"
  },
  "dependencies": {
    "@gamedevland/engine": "0.0.1"
  },
  "peerDependencies": {
    "vite": "^7.1.0"
  }
}
