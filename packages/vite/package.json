{
  "name": "@gamedevland/vite",
  "version": "0.0.2",
  "type": "module",
  "description": "Vite build tooling for Gamedev Land HTML5 games.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Gamedev Land",
  "homepage": "https://github.com/gamedevland/sdk#readme",
  "bugs": {
    "url": "https://github.com/gamedevland/sdk/issues"
  },
  "keywords": [
    "gamedev",
    "html5-game",
    "vite",
    "typescript",
    "sdk"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "pretypecheck": "npm run build -w @gamedevland/engine",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths"
  },
  "dependencies": {
    "@gamedevland/engine": "0.0.3"
  },
  "peerDependencies": {
    "vite": "^7.1.0 || ^8.0.0"
  }
}
