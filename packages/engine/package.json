{
  "name": "@gamedevland/engine",
  "version": "0.0.10",
  "type": "module",
  "description": "HTML5 game engine SDK for AI-assisted web game development.",
  "license": "MIT",
  "author": "Gamedev Land",
  "keywords": [
    "gamedev",
    "html5-game",
    "game-engine",
    "pixi",
    "vite",
    "typescript",
    "sdk"
  ],
  "main": "./dist/sdk.js",
  "module": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "sideEffects": false,
  "files": [
    "dist/sdk.js",
    "dist/sdk.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./assets": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./audio": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./commands": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./configs": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./core": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./di": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./errors": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./events": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./fsm": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./input": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./interactions": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./layouts": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./physics": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./particles": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./platforms": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./prefabs": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./scenes": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./screen": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./tween": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./validation": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "test:screen": "node scripts/verify-screen.mjs",
    "test:resource-cleanup": "node scripts/verify-resource-cleanup.mjs",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc --noEmit && node scripts/build-package.mjs && dts-bundle-generator --no-check --project tsconfig.json --out-file dist/sdk.d.ts src/index.ts && node scripts/fix-sdk-dts.mjs"
  },
  "dependencies": {
    "@spd789562/particle-emitter": "^1.0.2",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamedevland/sdk.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/gamedevland/sdk/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/gamedevland/sdk/issues"
  }
}
