  "scripts": {
    "test:screen": "node scripts/verify-screen.mjs",
    "test:resource-cleanup": "node scripts/verify-resource-cleanup.mjs",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc --noEmit && node scripts/build-package.mjs && tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "howler": "^2.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamedevland/sdk.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/gamedevland/sdk/tree/main/packages/engine#readme",
