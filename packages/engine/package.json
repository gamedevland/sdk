{
  "name": "@gamedevland/engine",
  "version": "0.0.13-rings-texture.1",
  "type": "module",
  "description": "HTML5 game engine SDK for AI-assisted web game development.",
  "license": "MIT",
  "author": "Gamedev Land",
  "keywords": [
    "gamedev",
    "html5-game",
    "game-engine",
    "pixi",
    "vite",
    "typescript",
    "sdk"
  ],
  "main": "./dist/sdk.js",
  "module": "./dist/sdk.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATION_RENDERERS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
