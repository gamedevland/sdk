{
  "world": {
    "type": "Group",
    "children": {
      "camera": {
        "type": "PerspectiveCamera",
        "props": {
          "position": { "x": 0, "y": 1, "z": 4 },
          "lookAt": { "x": 0, "y": 0, "z": 0 },
          "near": 0.1,
          "far": 100,
          "fov": 45
        }
      },
      "light": {
        "type": "AmbientLight",
        "props": { "color": "#ffffff", "intensity": 2 }
      },
      "item": {
        "type": "Mesh",
        "props": {
          "geometry": { "type": "box", "size": { "x": 1, "y": 1, "z": 1 } },
          "material": { "type": "standard", "color": "#55bb99" },
          "rotation": { "x": 0.2, "y": 0.5, "z": 0 }
        }
      }
    }
  }
}
