{
  "name": "@gamedevland/sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:locales": "node scripts/verify-locales.mjs",
    "test:audio": "node scripts/verify-audio-activation.mjs && node scripts/verify-music-single-instance.mjs",
    "test:crazygames": "node scripts/verify-crazygames.mjs",
    "test:playgama": "node scripts/verify-playgama.mjs",
    "test:project-template": "node scripts/verify-project-template.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test:renderers": "node scripts/verify-renderers.mjs",
    "pack:local": "node scripts/pack-local-engine.mjs",
    "test:local-package": "node scripts/verify-local-package.mjs",
    "test:stability": "node scripts/verify-stability.mjs",
    "test:archive-dependency": "node scripts/verify-archive-dependency.mjs",
    "test:three-texture": "node scripts/verify-three-texture.mjs"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.7.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "archiver-utils": {
      "glob": "14.0.2"
    }
  }
}
